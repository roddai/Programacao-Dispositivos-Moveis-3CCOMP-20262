<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:padding="30dp"

    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livraria Fecap"
        android:textSize="35sp"
        android:textColor="@color/white"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageLivro1"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/Livro1"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toStartOf="@+id/imageLivro2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo"
         />

    <ImageView
        android:id="@+id/imageLivro2"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/Livro2"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toStartOf="@+id/imageLivro3"
        app:layout_constraintStart_toEndOf="@+id/imageLivro1"
        app:layout_constraintTop_toBottomOf="@+id/titulo"
        />

    <ImageView
        android:id="@+id/imageLivro3"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/Livro3"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageLivro2"
        app:layout_constraintTop_toBottomOf="@+id/titulo"
        />

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintEnd_toStartOf="@id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageLivro1"
         />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintEnd_toStartOf="@id/button3"
        app:layout_constraintStart_toEndOf="@id/button1"
        app:layout_constraintTop_toBottomOf="@id/imageLivro2"
         />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button2"
        app:layout_constraintTop_toBottomOf="@+id/imageLivro3"
         />

</androidx.constraintlayout.widget.ConstraintLayout>