<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:padding="30dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="LIVRARIA FECAP"
        android:textStyle="bold"
        android:textSize="40sp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/livroIA01"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/LivroIA01"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@id/livroIA02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <ImageView
        android:id="@+id/livroIA02"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/LivroIA02"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@id/livroIA03"
        app:layout_constraintStart_toEndOf="@id/livroIA01"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <ImageView
        android:id="@+id/livroIA03"
        android:layout_width="100dp"
        android:layout_height="140dp"
        app:srcCompat="@drawable/LivroIA03"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/livroIA02"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        android:layout_marginTop="10dp"
        tools:layout_editor_absoluteX="161dp"
        tools:layout_editor_absoluteY="280dp"
        app:layout_constraintEnd_toStartOf="@id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/livroIA01"/>

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        android:layout_marginTop="10dp"
        tools:layout_editor_absoluteX="161dp"
        tools:layout_editor_absoluteY="280dp"
        app:layout_constraintEnd_toStartOf="@id/button3"
        app:layout_constraintStart_toEndOf="@id/button1"
        app:layout_constraintTop_toBottomOf="@id/livroIA02"/>

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        android:layout_marginTop="10dp"
        tools:layout_editor_absoluteX="161dp"
        tools:layout_editor_absoluteY="280dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button2"
        app:layout_constraintTop_toBottomOf="@id/livroIA03"/>


</androidx.constraintlayout.widget.ConstraintLayout>