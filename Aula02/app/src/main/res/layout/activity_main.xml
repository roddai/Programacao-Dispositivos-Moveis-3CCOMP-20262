<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:padding="30dp"
    tools:context=".MainActivity">
    <TextView
      android:id="@+id/Titulo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:text="LIVRARIA FECAP"
      android:textSize="30dp"
      android:textColor="@color/white"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgcapamiranha"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="15dp"
        app:srcCompat="@drawable/capamiranha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgbrabo"
        app:layout_constraintTop_toBottomOf="@id/Titulo" />

    <ImageView
        android:id="@+id/imgbrabo"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="15dp"
        app:srcCompat="@drawable/brabo"
        app:layout_constraintStart_toEndOf="@id/imgcapamiranha"
        app:layout_constraintEnd_toStartOf="@id/imgultimacacada"
        app:layout_constraintTop_toBottomOf="@id/Titulo" />

    <ImageView
        android:id="@+id/imgultimacacada"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginTop="15dp"
        app:srcCompat="@drawable/ultimacacada"
        app:layout_constraintStart_toEndOf="@id/imgbrabo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Titulo" />

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button2"
        app:layout_constraintTop_toBottomOf="@id/imgcapamiranha" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintStart_toEndOf="@id/button1"
        app:layout_constraintEnd_toStartOf="@id/button3"
        app:layout_constraintTop_toBottomOf="@id/imgbrabo" />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        app:layout_constraintStart_toEndOf="@id/button2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgultimacacada" />

</androidx.constraintlayout.widget.ConstraintLayout>