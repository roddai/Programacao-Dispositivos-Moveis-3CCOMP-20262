<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JoKenPo"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/imgMaquina"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/maquina"
        android:contentDescription="Máquina"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgInterrogacaoMaquina"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/imgInterrogacaoMaquina"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/interrogacao"
        android:contentDescription="Interrogação Máquina"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toEndOf="@id/imgMaquina"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgMaquina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/imgUsuarioSelecionado"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/interrogacao"
        android:contentDescription="Personagem do Usuário"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgUsuarioJogada"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/imgUsuarioJogada"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/interrogacao"
        android:contentDescription="Jogada do Usuário"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        app:layout_constraintStart_toEndOf="@id/imgUsuarioSelecionado"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtEscolhaSimbolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um símbolo"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgUsuarioJogada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <ImageView
        android:id="@+id/imgPedra"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/pedra"
        android:contentDescription="Pedra"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimbolo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgPapel"
        android:layout_marginTop="12dp" />

    <ImageView
        android:id="@+id/imgPapel"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/papel"
        android:contentDescription="Papel"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimbolo"
        app:layout_constraintStart_toEndOf="@id/imgPedra"
        app:layout_constraintEnd_toStartOf="@id/imgTesoura"
        android:layout_marginTop="12dp" />

    <ImageView
        android:id="@+id/imgTesoura"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/tesoura"
        android:contentDescription="Tesoura"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimbolo"
        app:layout_constraintStart_toEndOf="@id/imgPapel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/txtEscolhaPersonagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha seu personagem"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgPapel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <ImageView
        android:id="@+id/imgUsuarioFem"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/usuario_fem"
        android:contentDescription="Personagem Feminino"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaPersonagem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgUsuarioMasc"
        android:layout_marginTop="12dp" />

    <ImageView
        android:id="@+id/imgUsuarioMasc"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/usuario_masc"
        android:contentDescription="Personagem Masculino"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaPersonagem"
        app:layout_constraintStart_toEndOf="@id/imgUsuarioFem"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>