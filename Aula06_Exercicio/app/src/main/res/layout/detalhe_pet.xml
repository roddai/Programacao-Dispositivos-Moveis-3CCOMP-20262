<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/ttlDetalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalhes do Pet!"
        android:textSize="35dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgPet"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/ttlDetalhes"
        app:layout_constraintEnd_toEndOf="@+id/ttlDetalhes"
        app:layout_constraintStart_toStartOf="@+id/ttlDetalhes"
        app:layout_constraintBottom_toTopOf="@+id/detalhePet"
        />

    <TextView
        android:id="@+id/detalhePet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" "
        android:textSize="35dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgPet"
         />


</androidx.constraintlayout.widget.ConstraintLayout>