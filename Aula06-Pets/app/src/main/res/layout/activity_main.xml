<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_claro"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/azul"
        android:text="FECAP PET!"
        android:layout_marginTop="50dp"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/caes"
        android:text="Cães"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:paddingTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TextView"/>

    <TextView
        android:id="@+id/gatos"
        android:text="Gatos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:paddingTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cao2"/>

    <Button
        android:id="@+id/cao1"
        android:text="Rex"
        android:backgroundTint="@color/azul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgcao1"/>

    <Button
        android:id="@+id/cao2"
        android:text="Thor"
        android:backgroundTint="@color/azul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgcao2"/>

    <Button
        android:id="@+id/cao3"
        android:text="Luna"
        android:layout_width="wrap_content"
        android:backgroundTint="@color/azul"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/imgcao3"/>

    <Button
        android:id="@+id/gato1"
        android:text="Steph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/azul"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imggato1"/>

    <Button
        android:id="@+id/gato2"
        android:text="Marg"
        android:backgroundTint="@color/azul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imggato2"/>

    <Button
        android:id="@+id/gato3"
        android:text="Fran"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/azul"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/imggato3"/>

    <ImageView
        android:id="@+id/imgcao1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/rex"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caes"/>

    <ImageView
        android:id="@+id/imgcao2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/thor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caes"/>

    <ImageView
        android:id="@+id/imgcao3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/luna"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/caes"/>

    <ImageView
        android:id="@+id/imggato1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/steph"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gatos"/>

    <ImageView
        android:id="@+id/imggato2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/marg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gatos"/>

    <ImageView
        android:id="@+id/imggato3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/fran"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/gatos"/>



</androidx.constraintlayout.widget.ConstraintLayout>