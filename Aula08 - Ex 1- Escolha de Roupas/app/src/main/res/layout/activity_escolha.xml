<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:padding="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
    android:id="@+id/TituloForm"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Formulário"
    android:textSize="32sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginTop="40dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/editNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Digite seu nome"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/TituloForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editIdade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Digite sua idade"
        android:ems="2"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/editNome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioButton
        android:id="@+id/rbP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="P"
        app:layout_constraintTop_toBottomOf="@id/editIdade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rbM"/>

    <RadioButton
        android:id="@+id/rbM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="M"
        app:layout_constraintTop_toBottomOf="@id/editIdade"
        app:layout_constraintStart_toEndOf="@id/rbP"
        app:layout_constraintEnd_toStartOf="@id/rbG"/>

    <RadioButton
        android:id="@+id/rbG"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="G"
        app:layout_constraintTop_toBottomOf="@id/editIdade"
        app:layout_constraintStart_toEndOf="@id/rbM"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/spinnerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha uma cor:"
        app:layout_constraintTop_toBottomOf="@id/rbG"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/spinnerColor"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/spinnerText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp"/>

    <CheckBox
        android:id="@+id/cbCamisa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camisa"
        app:layout_constraintTop_toBottomOf="@id/spinnerColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbCalca"
        android:layout_marginTop="15dp"/>

    <CheckBox
        android:id="@+id/cbCalca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calça"
        app:layout_constraintTop_toBottomOf="@id/spinnerColor"
        app:layout_constraintStart_toEndOf="@id/cbCamisa"
        app:layout_constraintEnd_toStartOf="@id/cbJaqueta"
        android:layout_marginTop="15dp"/>

    <CheckBox
        android:id="@+id/cbJaqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jaqueta"
        app:layout_constraintTop_toBottomOf="@id/spinnerColor"
        app:layout_constraintStart_toEndOf="@id/cbCalca"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/textAvaliacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avalie o aplicativo:"
        app:layout_constraintTop_toBottomOf="@id/cbJaqueta"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"
        app:layout_constraintTop_toBottomOf="@id/textAvaliacao"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enviar"
        app:layout_constraintTop_toBottomOf="@id/ratingBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


</androidx.constraintlayout.widget.ConstraintLayout>