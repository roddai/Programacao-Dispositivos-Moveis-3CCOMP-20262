<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JoKenPo"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <ImageView
        android:id="@+id/imgMaquina"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/maquina"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgResulMaq"
        android:layout_marginTop="20dp" />

    <ImageView
        android:id="@+id/imgResulMaq"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/interrogacao"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toEndOf="@id/imgMaquina"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgMaquina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <ImageView
        android:id="@+id/imgJogador"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/usuario_fem"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgResulJog"
        android:layout_marginTop="20dp" />

    <ImageView
        android:id="@+id/imgResulJog"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/interrogacao"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        app:layout_constraintStart_toEndOf="@id/imgJogador"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


    <TextView
        android:id="@+id/txtEscolhaSimb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um símbolo"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgJogador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <ImageView
        android:id="@+id/imgPedra"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/pedra"
        android:contentDescription="Pedra"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgPapel"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/imgPapel"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/papel"
        android:contentDescription="Papel"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimb"
        app:layout_constraintStart_toEndOf="@id/imgPedra"
        app:layout_constraintEnd_toStartOf="@id/imgTesoura"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/imgTesoura"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/tesoura"
        android:contentDescription="Tesoura"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimb"
        app:layout_constraintStart_toEndOf="@id/imgPapel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txtEscolhaPers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um Jogador"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/imgPapel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />

    <ImageView
        android:id="@+id/imgJogadorFem"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/usuario_fem"
        android:contentDescription="feminino"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaPers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgJogadorMasc"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/imgJogadorMasc"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/usuario_masc"
        android:contentDescription="masculino"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaPers"
        app:layout_constraintStart_toEndOf="@id/imgJogadorFem"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
