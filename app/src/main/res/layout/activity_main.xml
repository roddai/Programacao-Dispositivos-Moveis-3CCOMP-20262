<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cotação de Moedas"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvLabelOrigem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real Brasileiro (BRL)"
        android:textColor="#A0A0A0"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"/>

    <Spinner
        android:id="@+id/spinnerOrigem"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#00E676"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelOrigem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etValorOrigem"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#00E676"
        android:hint="Digite o valor"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:inputType="numberDecimal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerOrigem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvLabelDestino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dólar Americano (USD)"
        android:textColor="#A0A0A0"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/etValorOrigem"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"/>

    <Spinner
        android:id="@+id/spinnerDestino"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#00E676"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelDestino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etValorDestino"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#00E676"
        android:hint="Valor convertido"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:focusable="false"
        android:clickable="false"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerDestino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnConverter"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Converter"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00E676"
        app:layout_constraintTop_toBottomOf="@id/etValorDestino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnConverter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo das Cotações"
                android:textColor="#00E676"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvResultadoGeral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Insira um valor e clique em converter."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>