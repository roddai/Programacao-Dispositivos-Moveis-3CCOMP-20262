<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caramelo"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECAP PET!"
        android:textSize="40dp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cães"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/Cachorro1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/Text1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/Cachorro2"/>

    <ImageView
        android:id="@+id/Cachorro2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/Text1"
        app:layout_constraintStart_toEndOf="@id/Cachorro1"
        app:layout_constraintEnd_toStartOf="@id/Cachorro3"/>

    <ImageView
        android:id="@+id/Cachorro3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/Text1"
        app:layout_constraintStart_toEndOf="@id/Cachorro2"
        app:layout_constraintEnd_toEndOf="parent"/>
    <Button
        android:id="@+id/btnRex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Cachorro1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLuna" />

    <Button
        android:id="@+id/btnLuna"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Cachorro2"
        app:layout_constraintStart_toEndOf="@id/btnRex"
        app:layout_constraintEnd_toStartOf="@id/btnSkibi" />

    <Button
        android:id="@+id/btnSkibi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Cachorro3"
        app:layout_constraintStart_toEndOf="@id/btnLuna"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gatos"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="300dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/Gato1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/text2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/Cachorro2"/>

    <ImageView
        android:id="@+id/Gato2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/text2"
        app:layout_constraintStart_toEndOf="@id/Cachorro1"
        app:layout_constraintEnd_toStartOf="@id/Cachorro3"/>

    <ImageView
        android:id="@+id/Gato3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_launcher_background"
        app:layout_constraintTop_toBottomOf="@id/text2"
        app:layout_constraintStart_toEndOf="@id/Cachorro2"
        app:layout_constraintEnd_toEndOf="parent"/>
    <Button
        android:id="@+id/Oggy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Gato1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLuna" />

    <Button
        android:id="@+id/Tom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Gato2"
        app:layout_constraintStart_toEndOf="@id/Oggy"
        app:layout_constraintEnd_toStartOf="@id/Larry" />

    <Button
        android:id="@+id/Larry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/Gato3"
        app:layout_constraintStart_toEndOf="@id/Tom"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>