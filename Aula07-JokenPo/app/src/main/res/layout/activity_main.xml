<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:layout_marginTop="25dp"
        android:text="JoKenPo"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgMaquina"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Máquina"
        app:layout_constraintEnd_toStartOf="@id/imgEscolhaUsuario"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        android:src="@drawable/maquina" />

    <ImageView
        android:id="@+id/imgEscolhaUsuario"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Escolha do usuário"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        android:src="@drawable/interrogacao"
        />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:text="Resultado"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgEscolhaUsuario" />

    <ImageView
        android:id="@+id/imgPersonagemSelecionado"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Personagem selecionado"
        android:src="@drawable/interrogacao"
        app:layout_constraintEnd_toStartOf="@id/imgResultadoUsuario"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        />

    <ImageView
        android:id="@+id/imgResultadoUsuario"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Símbolo escolhido pelo usuário"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        android:src="@drawable/interrogacao"/>

    <TextView
        android:id="@+id/txtEscolhaSimbolo"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="Escolha um símbolo"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgResultadoUsuario" />

    <ImageView
        android:id="@+id/imgPapel"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:contentDescription="Papel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSimbolo"
        android:src="@drawable/papel"
        />

    <ImageView
        android:id="@+id/imgPedra"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="25dp"
        android:clickable="true"
        android:contentDescription="Pedra"
        app:layout_constraintBottom_toBottomOf="@id/imgPapel"
        app:layout_constraintEnd_toStartOf="@id/imgPapel"
        app:layout_constraintTop_toTopOf="@id/imgPapel"
        android:src="@drawable/pedra"
        />

    <ImageView
        android:id="@+id/imgTesoura"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="25dp"
        android:clickable="true"
        android:contentDescription="Tesoura"
        app:layout_constraintBottom_toBottomOf="@id/imgPapel"
        app:layout_constraintStart_toEndOf="@id/imgPapel"
        app:layout_constraintTop_toTopOf="@id/imgPapel"
        android:src="@drawable/tesoura"/>

    <TextView
        android:id="@+id/txtEscolhaSeuPersonagem"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="Escolha seu personagem"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPapel" />

    <ImageView
        android:id="@+id/imgUsuarioMasc"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:contentDescription="Personagem dois"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEscolhaSeuPersonagem"
        android:src="@drawable/usuario_masc"
        />

    <ImageView
        android:id="@+id/imgUsuarioFem"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="25dp"
        android:clickable="true"
        android:contentDescription="Personagem um"
        app:layout_constraintBottom_toBottomOf="@id/imgUsuarioMasc"
        app:layout_constraintEnd_toStartOf="@id/imgUsuarioMasc"
        app:layout_constraintTop_toTopOf="@id/imgUsuarioMasc"
        android:src="@drawable/usuario_fem"/>

</androidx.constraintlayout.widget.ConstraintLayout>